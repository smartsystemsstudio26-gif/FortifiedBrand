{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "rating"
  ]
}