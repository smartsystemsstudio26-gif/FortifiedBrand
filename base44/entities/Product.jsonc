{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "slug": {
      "type": "string",
      "description": "URL slug"
    },
    "price": {
      "type": "number",
      "description": "Price in ZAR"
    },
    "collection": {
      "type": "string",
      "enum": [
        "New Arrivals",
        "Best Sellers",
        "Oversized Collection",
        "Premium Cotton Collection",
        "Limited Edition",
        "Featured Products"
      ],
      "default": "New Arrivals"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image URLs"
    },
    "gsm": {
      "type": "string",
      "default": "280 GSM"
    },
    "fit": {
      "type": "string",
      "default": "Oversized"
    },
    "material": {
      "type": "string",
      "default": "Premium Cotton"
    },
    "made_in": {
      "type": "string",
      "default": "South Africa"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "XS",
        "S",
        "M",
        "L",
        "XL",
        "XXL"
      ]
    },
    "stock": {
      "type": "number",
      "default": 25
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "price"
  ]
}